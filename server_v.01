from fastapi.responses import HTMLResponse
from fastapi.staticfiles import StaticFiles
import duckdb
import pandas as pd

# Add project root to sys.path
PROJECT_ROOT = Path(__file__).resolve().parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from src.common.gyst import GYSTUUID, encode_poly_market_uuid, encode_kalshi_market_uuid

app = FastAPI(title="GYST Prediction Market Control Center")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Global Minting State
mint_status = {
    "is_running": False,
    "current_file": None,
    "processed_count": 0,
    "last_log": "Idle",
    "error": None
}

@app.get("/api/status")
def get_status():
    minted_files = glob.glob("data/minted_parquet/*.parquet")
    return {
        "mint_status": mint_status,
        "minted_file_count": len(minted_files),
        "total_minted_bytes": sum(os.path.getsize(f) for f in minted_files) if minted_files else 0
    }

@app.post("/api/parse-uuid")
def parse_uuid(payload: dict):
    uuid_str = payload.get("uuid", "")
    try:
        parsed = GYSTUUID.parse(uuid_str)
        return {"success": True, "parsed": parsed}
    except Exception as e:
        return {"success": False, "error": str(e)}

@app.get("/api/explore-minted")
def explore_minted(limit: int = 20):
    minted_files = glob.glob("data/minted_parquet/*.parquet")
    if not minted_files:
        return {"success": True, "data": []}
    
    con = duckdb.connect()
    try:
        df = con.execute(f"""
            SELECT * FROM read_parquet('data/minted_parquet/*.parquet') 
            LIMIT {limit}
        """).df()
        # Convert non-serializable columns to string
        df = df.astype(str)
        return {"success": True, "columns": list(df.columns), "data": df.to_dict(orient="records")}
    except Exception as e:
        return {"success": False, "error": str(e)}

@app.get("/", response_class=HTMLResponse)
def serve_ui():
    return HTML_UI

