            const cols = data.columns;
            document.getElementById('table-head').innerHTML = cols.map(c => `<th class="p-3 uppercase tracking-wider">${c}</th>`).join('');
            
            document.getElementById('table-body').innerHTML = data.data.map(row => {
                return `<tr>${cols.map(c => `<td class="p-3 truncate max-w-[200px]">${row[c] || ''}</td>`).join('')}</tr>`;
            }).join('');
        }

        async function inspectUUID() {
            const uuid = document.getElementById('input-uuid').value.trim();
            if(!uuid) return;

            const res = await fetch('/api/parse-uuid', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ uuid })
            });
            const data = await res.json();

            if(data.success) {
                const p = data.parsed;
                document.getElementById('inspect-type').innerText = p.type_name;
                document.getElementById('inspect-code').innerText = p.type_code;
                document.getElementById('inspect-ns').innerText = '0x' + p.namespace_hash.toString(16);
                document.getElementById('inspect-signal').innerText = p.forecast_signal;
                document.getElementById('inspect-vv').innerText = `v${p.version} / var ${p.variant}`;
                document.getElementById('inspector-output').classList.remove('hidden');
            } else {
                alert("Error parsing UUID: " + data.error);
            }
        }

        // Auto Refresh on Load
        refreshData();
    </script>
</body>
