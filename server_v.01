    <script>
        async function refreshData() {
            const res = await fetch('/api/status');
            const data = await res.json();
            
            document.getElementById('stat-files').innerText = data.minted_file_count;
            document.getElementById('stat-size').innerText = (data.total_minted_bytes / (1024 * 1024)).toFixed(2) + ' MB';
            
            const badge = document.getElementById('badge-status');
            badge.innerText = data.minted_file_count > 0 ? "Ready / Active" : "Idle";
            badge.className = "px-3 py-1 text-xs rounded-full font-mono border bg-emerald-950 text-emerald-400 border-emerald-800";
