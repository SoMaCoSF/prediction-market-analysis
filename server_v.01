        async function loadExplorer() {
            const res = await fetch('/api/explore-minted?limit=15');
            const data = await res.json();
            
            if (!data.success || !data.data.length) {
                document.getElementById('table-head').innerHTML = `<th class="p-3">No data available in data/minted_parquet/</th>`;
                document.getElementById('table-body').innerHTML = ``;
                return;
